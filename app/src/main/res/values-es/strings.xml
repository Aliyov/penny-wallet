    <string name="privacy_sub">Sin internet, sin cuentas, sin rastreo</string>
    <string name="privacy_intro">Penny Wallet está hecha para que tu dinero siga siendo privado. Esto es lo que hace y lo que no hace.</string>
    <string name="privacy_offline_title">Sin acceso a internet</string>
    <string name="privacy_offline_body">La app no tiene permiso de internet, así que no puede enviar tus datos a ningún sitio. No hay anuncios, ni analíticas, ni registro.</string>
    <string name="privacy_local_title">Guardado solo en este teléfono</string>
    <string name="privacy_local_body">Las cuentas, los gastos y los ajustes se guardan en el almacenamiento privado de la app. La copia de seguridad en la nube de Android está desactivada para ella.</string>
    <string name="privacy_backup_title">Las copias van donde tú elijas</string>
    <string name="privacy_backup_body">Las copias de seguridad se guardan solo en la carpeta que elijas, y puedes protegerlas con una contraseña.</string>
    <string name="privacy_receipts_title">Los tickets se leen en el teléfono</string>
    <string name="privacy_receipts_body">El reconocimiento de texto se hace en este teléfono. La foto tomada para escanear se borra tras leerla; las fotos de tu galería solo se leen, nunca se copian.</string>
    <string name="privacy_crash_title">Informes de error solo si los envías</string>
    <string name="privacy_crash_body">Tras un cierre inesperado, Penny te muestra el informe y te deja enviarlo tú mismo por correo. Nada se envía por sí solo.</string>
    <string name="privacy_tips_title">Propinas a través de Google Play</string>
    <string name="privacy_tips_body">Las propinas se pagan a través de Google Play. Penny solo sabe que la propina se ha completado.</string>
