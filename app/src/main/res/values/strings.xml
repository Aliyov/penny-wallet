    <string name="privacy_title">Your data stays here</string>
    <string name="privacy_sub">No internet, no accounts, no tracking</string>
    <string name="privacy_intro">Penny Wallet is built so your money stays private. This is what it does and doesn\'t do.</string>
    <string name="privacy_offline_title">No internet access</string>
    <string name="privacy_offline_body">The app has no internet permission, so it can\'t send your data anywhere. There are no ads, no analytics and no sign-up.</string>
    <string name="privacy_local_title">Stored only on this phone</string>
    <string name="privacy_local_body">Accounts, expenses and settings are kept in the app\'s private storage. Android\'s cloud backup is switched off for it.</string>
    <string name="privacy_backup_title">Backups go where you choose</string>
    <string name="privacy_backup_body">Backups are written only to the folder you pick, and you can protect them with a password.</string>
    <string name="privacy_receipts_title">Receipts are read on the phone</string>
    <string name="privacy_receipts_body">Text recognition runs on this phone. A photo taken for a scan is deleted after reading; photos from your gallery are only read, never copied.</string>
    <string name="privacy_crash_title">Crash reports only if you send them</string>
    <string name="privacy_crash_body">After a crash, Penny shows the report and lets you send it by email yourself. Nothing is sent on its own.</string>
    <string name="privacy_tips_title">Tips through Google Play</string>
    <string name="privacy_tips_body">Tips are paid through Google Play. Penny only learns that the tip went through.</string>
