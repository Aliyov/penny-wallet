<resources>
    <style name="Theme.Penny" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/penny_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorAccent">@color/penny_accent</item>
    </style>

    <style name="Theme.Penny.Starting" parent="Theme.SplashScreen">
        <!-- The icon's own background colour and its artwork without a frame: opening the app reads as the icon
             growing to fill the screen, not as a badge stuck on a page. -->
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Penny</item>
    </style>
</resources>
