    <string name="privacy_title">Twoje dane zostają tutaj</string>
    <string name="privacy_sub">Bez internetu, bez kont, bez śledzenia</string>
    <string name="privacy_intro">Penny Wallet powstał tak, aby twoje finanse pozostały prywatne. Oto co aplikacja robi, a czego nie.</string>
    <string name="privacy_offline_title">Bez dostępu do internetu</string>
    <string name="privacy_offline_body">Aplikacja nie ma uprawnienia do internetu, więc nie może nigdzie wysłać twoich danych. Bez reklam, bez analityki i bez rejestracji.</string>
    <string name="privacy_local_title">Zapisane tylko na tym telefonie</string>
    <string name="privacy_local_body">Konta, wydatki i ustawienia są przechowywane w prywatnej pamięci aplikacji. Kopia zapasowa Androida w chmurze jest dla niej wyłączona.</string>
    <string name="privacy_backup_title">Kopie zapasowe trafiają tam, gdzie chcesz</string>
    <string name="privacy_backup_body">Kopie zapasowe są zapisywane tylko w wybranym przez ciebie folderze i możesz je chronić hasłem.</string>
    <string name="privacy_receipts_title">Paragony są odczytywane na telefonie</string>
    <string name="privacy_receipts_body">Rozpoznawanie tekstu działa na tym telefonie. Zdjęcie zrobione do skanowania jest usuwane po odczytaniu; zdjęcia z galerii są tylko odczytywane, nigdy kopiowane.</string>
    <string name="privacy_crash_title">Raporty o awariach tylko, jeśli je wyślesz</string>
    <string name="privacy_crash_body">Po awarii Penny pokazuje raport i pozwala ci samodzielnie wysłać go e-mailem. Nic nie jest wysyłane automatycznie.</string>
    <string name="privacy_tips_title">Napiwki przez Google Play</string>
    <string name="privacy_tips_body">Napiwki są opłacane przez Google Play. Penny dowiaduje się tylko, że napiwek dotarł.</string>
